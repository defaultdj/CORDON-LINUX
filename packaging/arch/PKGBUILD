# Maintainer: CordonIX contributors
# Сборка: cd packaging/arch && makepkg -si
# Пакет собирается из локальной копии репозитория: prepare() делает git archive текущего HEAD.
pkgname=cordonix
pkgver=0.2.0
pkgrel=1
pkgdesc="Лаунчер профилей и модов S.T.A.L.K.E.R. для UNIX/Linux (OpenXRay / Proton)"
arch=('any')
url="https://github.com/defaultdj/CordonIX"
license=('GPL-3.0-only')
depends=(
  'python'
  'pyside6'            # графический интерфейс: берём системный PySide6, не тянем копию из PyPI
  'desktop-file-utils' # update-desktop-database для пункта меню
  'xdg-utils'          # xdg-open: «открыть каталог профиля»
)
optdepends=(
  'fuse3: backend «fuse-overlayfs» (fusermount3, доступ к /dev/fuse)'
  'fuse-overlayfs: backend «fuse-overlayfs»'
  '7zip: установка модов из .7z (пакет заменяет устаревший p7zip)'
  'unrar: установка модов из .rar'
  'libarchive: bsdtar для отдельных tar-архивов'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$pkgname-$pkgver.tar.gz::$pkgname.tar.gz")
sha256sums=('SKIP')

prepare() {
  ( cd ../.. && git archive --format=tar.gz -o "packaging/arch/$pkgname.tar.gz" HEAD )
  mkdir -p "$srcdir/$pkgname-$pkgver"
  tar -xzf "$pkgname.tar.gz" -C "$srcdir/$pkgname-$pkgver"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 packaging/cordonix.desktop \
    "$pkgdir/usr/share/applications/cordonix.desktop"
  install -Dm644 packaging/cordonix.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/cordonix.svg"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/USER_GUIDE_LINUX_RU.md \
    "$pkgdir/usr/share/doc/$pkgname/USER_GUIDE_LINUX_RU.md"
  install -Dm644 docs/TECHNICAL_LINUX_EN.md \
    "$pkgdir/usr/share/doc/$pkgname/TECHNICAL_LINUX_EN.md"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
